<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041.0：再生中の曲（Windows のメディア情報）を読むため。Windows 10 2004 以降で動く -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MyDashboard</AssemblyName>
    <RootNamespace>MyDashboard</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <!-- Windows 以外（クラウドの Linux）でもコンパイル確認できるようにする。実行は Windows のみ -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- 1つのexeにまとめる設定（build.bat から dotnet publish で使用） -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- CPU/GPU/ディスクのセンサー取得 -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- オーロラの Twitch 表示（Edge の WebView2。ランタイムは Windows 10/11 に入っている） -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
  </ItemGroup>

  <ItemGroup>
    <!-- ウィンドウ・タスクバー用（exe のアイコンは ApplicationIcon で設定） -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

</Project>
