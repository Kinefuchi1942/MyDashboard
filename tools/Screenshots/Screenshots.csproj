<Project Sdk="Microsoft.NET.Sdk">

  <!--
    README の画面写真を見本データから作る（実機のセンサーやネットは使わない）。
    使い方：dotnet run -c Release で tools\Screenshots を実行（PROJECT.md を参照）
    出力：docs\images\*.png（1920×1080）
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 本体（単一 exe・自己完結）をライブラリとして参照するため -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MyDashboard.csproj" />
  </ItemGroup>

</Project>
