<UserControl x:Class="MyDashboard.Views.GaugeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MyDashboard.Controls">
    <!-- 計器盤レイアウト：CPU・FPS・GPU の3連メーター。中央の FPS がいちばん大きい -->
    <UserControl.Background>
        <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.8">
            <GradientStop Color="#16202C" Offset="0"/>
            <GradientStop Color="#0A0E14" Offset="1"/>
        </RadialGradientBrush>
    </UserControl.Background>

    <UserControl.Resources>
        <Style x:Key="GaugeLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Foreground" Value="#7F8DA3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="GaugeValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontStretch" Value="SemiCondensed"/>
            <Setter Property="Foreground" Value="#EEF2F8"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="GaugeUnit" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7F8DA3"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style x:Key="GaugeSub" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="Foreground" Value="#AEB9CA"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="StripLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#7F8DA3"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="StripValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontStretch" Value="SemiCondensed"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Foreground" Value="#EEF2F8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="21"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="TextElement.FontSize" Value="22"/>
            <Setter Property="TextElement.Foreground" Value="#4F5B6D"/>
        </Style>
    </UserControl.Resources>

    <Canvas Width="1920" Height="1080">

        <!-- ============ 状態・注意書き（メーターと下段のあいだ） -->
        <StackPanel Canvas.Left="120" Canvas.Top="790" Orientation="Horizontal">
            <TextBlock x:Name="Status" FontFamily="{StaticResource UiFont}" FontSize="20" Foreground="#7F8DA3"/>
            <TextBlock x:Name="Notice" FontFamily="{StaticResource UiFont}" FontSize="20" Foreground="{StaticResource Warn}" Margin="24,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="ClockText" Canvas.Right="120" Canvas.Top="40" FontFamily="{StaticResource NumFont}" FontWeight="SemiBold"
                   FontSize="48" Foreground="#EEF2F8" Text="00:00"/>

        <!-- ============ Present Mode（左上、時計と同じ高さ）。ゲーム中だけ表示 -->
        <StackPanel x:Name="PresentPanel" Canvas.Left="120" Canvas.Top="51" Orientation="Horizontal" Visibility="Collapsed">
            <Border x:Name="PresentChip" Style="{StaticResource Chip}">
                <TextBlock x:Name="PresentText" VerticalAlignment="Center"/>
            </Border>
            <TextBlock FontFamily="{StaticResource UiFont}" FontSize="18" Foreground="#7F8DA3" VerticalAlignment="Center" Margin="18,0,0,0">
                <Run Text="Present Mode" Foreground="#5A6578"/><Run x:Name="PresentNote"/>
            </TextBlock>
        </StackPanel>

        <!-- ============ CPU メーター（中心 370,448 / 半径225） -->
        <Grid Canvas.Left="115" Canvas.Top="193" Width="510" Height="510">
            <c:ArcGauge x:Name="CpuTrack" Part="Track"/>
            <c:ArcGauge x:Name="CpuArc" Part="Value" Stroke="{StaticResource Cpu}">
                <c:ArcGauge.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.75" Color="{StaticResource CpuColor}"/>
                </c:ArcGauge.Effect>
            </c:ArcGauge>
            <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                <TextBlock Text="CPU" Style="{StaticResource GaugeLabel}" FontSize="29"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-14,0,-12">
                    <TextBlock x:Name="CpuValue" Style="{StaticResource GaugeValue}" FontSize="150" Text="--"/>
                    <TextBlock Text="%" Style="{StaticResource GaugeUnit}" FontSize="46" Margin="6,0,0,30"/>
                </StackPanel>
                <TextBlock x:Name="CpuSub" Style="{StaticResource GaugeSub}" FontSize="29" Text="--"/>
            </StackPanel>
        </Grid>

        <!-- ============ スレッド負荷（CPU メーターの下の開いた部分） -->
        <Grid Canvas.Left="130" Canvas.Top="666" Width="480">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <TextBlock FontFamily="{StaticResource UiFont}" FontSize="20" Foreground="#7F8DA3" VerticalAlignment="Bottom">
                <Run Text="スレッド "/><Run x:Name="ThreadCount" Text="--" FontFamily="{StaticResource NumFont}" FontSize="22" FontWeight="SemiBold" Foreground="#EEF2F8"/>
            </TextBlock>
            <TextBlock FontFamily="{StaticResource UiFont}" FontSize="20" Foreground="#7F8DA3" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Run Text="最大 "/><Run x:Name="ThreadMax" Text="--" FontFamily="{StaticResource NumFont}" FontSize="22" FontWeight="SemiBold" Foreground="#EEF2F8"/><Run Text=" %" FontFamily="{StaticResource NumFont}" FontSize="18"/>
            </TextBlock>
            <c:CoreBars x:Name="Threads" Grid.Row="1" Margin="0,10,0,0"/>
        </Grid>

        <!-- ============ FPS メーター（中心 960,424 / 半径295） -->
        <Grid Canvas.Left="635" Canvas.Top="99" Width="650" Height="650">
            <c:ArcGauge x:Name="FpsTrack" Part="Track"/>
            <c:ArcGauge x:Name="FpsArc" Part="Value" Stroke="#F2F5FA" Thickness="16">
                <c:ArcGauge.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="28" Opacity="0.7" Color="#F2F5FA"/>
                </c:ArcGauge.Effect>
            </c:ArcGauge>
            <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                <TextBlock x:Name="FpsLabel" Text="FPS" Style="{StaticResource GaugeLabel}" FontSize="38" MaxWidth="440"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-18,0,-16">
                    <TextBlock x:Name="FpsValue" Style="{StaticResource GaugeValue}" FontSize="200" Text="--"/>
                    <TextBlock Text="fps" Style="{StaticResource GaugeUnit}" FontSize="60" Margin="8,0,0,40"/>
                </StackPanel>
                <TextBlock x:Name="FpsSub" Style="{StaticResource GaugeSub}" FontSize="38" Text="ゲームの描画を待っています" MaxWidth="460"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- ============ GPU メーター（中心 1550,448 / 半径225） -->
        <Grid Canvas.Left="1295" Canvas.Top="193" Width="510" Height="510">
            <c:ArcGauge x:Name="GpuTrack" Part="Track"/>
            <c:ArcGauge x:Name="GpuArc" Part="Value" Stroke="{StaticResource Gpu}">
                <c:ArcGauge.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.75" Color="{StaticResource GpuColor}"/>
                </c:ArcGauge.Effect>
            </c:ArcGauge>
            <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                <TextBlock Text="GPU" Style="{StaticResource GaugeLabel}" FontSize="29"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-14,0,-12">
                    <TextBlock x:Name="GpuValue" Style="{StaticResource GaugeValue}" FontSize="150" Text="--"/>
                    <TextBlock Text="%" Style="{StaticResource GaugeUnit}" FontSize="46" Margin="6,0,0,30"/>
                </StackPanel>
                <TextBlock x:Name="GpuSub" Style="{StaticResource GaugeSub}" FontSize="29" Text="--"/>
            </StackPanel>
        </Grid>

        <!-- ============ フレームタイム（FPS メーターの下の開いた部分） -->
        <Grid x:Name="FrameTimePanel" Canvas.Left="690" Canvas.Top="660" Width="540" Opacity="0.45">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock FontFamily="{StaticResource UiFont}" FontSize="20" Foreground="#7F8DA3" VerticalAlignment="Bottom">
                <Run Text="フレームタイム "/><Run x:Name="FtValue" Text="--" FontFamily="{StaticResource NumFont}" FontSize="26" FontWeight="SemiBold" Foreground="#EEF2F8"/><Run Text=" ms" FontFamily="{StaticResource NumFont}" FontSize="18"/>
            </TextBlock>
            <TextBlock FontFamily="{StaticResource UiFont}" FontSize="20" Foreground="#7F8DA3" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Run Text="1% Low "/><Run x:Name="LowValue" Text="--" FontFamily="{StaticResource NumFont}" FontSize="26" FontWeight="SemiBold" Foreground="#EEF2F8"/><Run Text=" fps" FontFamily="{StaticResource NumFont}" FontSize="18"/>
            </TextBlock>
            <c:FrameTimeChart x:Name="FrameChart" Grid.Row="1" Margin="0,6,0,0"/>
            <TextBlock x:Name="FtCaption" Grid.Row="2" FontFamily="{StaticResource UiFont}" FontSize="15" Foreground="#5A6578" Margin="0,4,0,0"
                       Text="直近10秒"/>
        </Grid>

        <!-- ============ DLSS（GPU メーターの下）。ゲームが読み込んだ DLL から判定する -->
        <StackPanel x:Name="DlssPanel" Canvas.Left="1295" Canvas.Top="658" Width="510" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border x:Name="DlssSrChip" Style="{StaticResource Chip}">
                    <TextBlock x:Name="DlssSrText" Text="DLSS SR" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="DlssFgChip" Style="{StaticResource Chip}" Margin="12,0,0,0">
                    <TextBlock x:Name="DlssFgText" Text="DLSS FG" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="DlssRrChip" Style="{StaticResource Chip}" Margin="12,0,0,0">
                    <TextBlock x:Name="DlssRrText" Text="DLSS RR" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="DlssNote" FontFamily="{StaticResource NumFont}" FontSize="18" Foreground="#7F8DA3"
                       HorizontalAlignment="Center" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
        </StackPanel>

        <!-- ============ 下段：メモリ・VRAM・ディスク・ネットワークの推移 -->
        <Rectangle Canvas.Left="120" Canvas.Top="842" Width="1680" Height="1" Fill="#14FFFFFF"/>
        <Grid Canvas.Left="120" Canvas.Top="866" Width="1680" Height="130">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="メモリ" Style="{StaticResource StripLabel}"/>
            <TextBlock x:Name="MemText" Style="{StaticResource StripValue}" Text="--"/>
            <c:HistoryChart x:Name="MemChart" Grid.Row="1" Margin="0,12,0,0" Stroke="{StaticResource MemColor}" Max="100"
                            ShowGrid="False" FillOpacity="0.22" LineThickness="2"/>

            <TextBlock Grid.Column="2" Text="VRAM" Style="{StaticResource StripLabel}"/>
            <TextBlock Grid.Column="2" x:Name="VramText" Style="{StaticResource StripValue}" Text="--"/>
            <c:HistoryChart Grid.Column="2" x:Name="VramChart" Grid.Row="1" Margin="0,12,0,0" Stroke="{StaticResource GpuColor}" Max="100"
                            ShowGrid="False" FillOpacity="0.22" LineThickness="2"/>

            <TextBlock Grid.Column="4" Text="ディスク" Style="{StaticResource StripLabel}"/>
            <TextBlock Grid.Column="4" x:Name="DiskText" Style="{StaticResource StripValue}" Text="--"/>
            <c:HistoryChart Grid.Column="4" x:Name="DiskChart" Grid.Row="1" Margin="0,12,0,0" Stroke="{StaticResource DiskColor}"
                            SecondStroke="#7A6496" Max="0" ShowGrid="False" FillOpacity="0.22" LineThickness="2"/>

            <TextBlock Grid.Column="6" Text="ネット" Style="{StaticResource StripLabel}"/>
            <TextBlock Grid.Column="6" x:Name="NetText" Style="{StaticResource StripValue}" Text="--"/>
            <c:HistoryChart Grid.Column="6" x:Name="NetChart" Grid.Row="1" Margin="0,12,0,0" Stroke="{StaticResource NetColor}"
                            SecondStroke="{StaticResource NetUpColor}" Max="0" ShowGrid="False" FillOpacity="0.22" LineThickness="2"/>
        </Grid>
    </Canvas>
</UserControl>
