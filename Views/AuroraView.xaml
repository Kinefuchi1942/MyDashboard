<UserControl x:Class="MyDashboard.Views.AuroraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MyDashboard.Controls"
             Background="#070A12">
    <!-- オーロラレイアウト：日常使い向け。時計・天気・ニュースが主役、PC の状態は控えめに -->
    <UserControl.Resources>
        <!-- 時間帯テーマの色。起動時にコードで差し替え、時間帯に合わせて色を変える（AT のあとの数字は不透明度％） -->
        <SolidColorBrush x:Key="AText" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="AT85" Color="#D9F4F7FB"/>
        <SolidColorBrush x:Key="AT80" Color="#CCF4F7FB"/>
        <SolidColorBrush x:Key="AT70" Color="#B3F4F7FB"/>
        <SolidColorBrush x:Key="AT60" Color="#99F4F7FB"/>
        <SolidColorBrush x:Key="AT50" Color="#80F4F7FB"/>
        <SolidColorBrush x:Key="AT40" Color="#66F4F7FB"/>
        <SolidColorBrush x:Key="AGlass" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="ALine" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="AAccent" Color="#7FE3F0"/>
        <SolidColorBrush x:Key="ACpu" Color="#7FE3F0"/>
        <SolidColorBrush x:Key="AGpu" Color="#B7A6FF"/>
        <SolidColorBrush x:Key="ARain" Color="#7FB2F0"/>

        <Style x:Key="Glass" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
        </Style>
        <Style x:Key="BarLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style x:Key="BarValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="BarSide" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="HourTime" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HourTemp" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HourRain" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- ニュースカードの前へ・次へボタン（テーマで色が変わるブラシは Style に書かず、各要素に書く） -->
        <Style x:Key="NewsButton" TargetType="Border">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="21"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 再生中カードの操作ボタン（前の曲・再生/一時停止・次の曲） -->
        <Style x:Key="MediaButton" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 「ニュース｜Twitch｜YouTube」の切り替えと、カード右上の小さなボタン（色はテーマで変わるため各要素に書く） -->
        <Style x:Key="SegTab" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="16,4,16,5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="SegText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style x:Key="CardButton" TargetType="Border">
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Padding" Value="13,5,15,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- フォロー中の一覧を横に送る矢印（入りきらないときだけ出す） -->
        <Style x:Key="ChipArrow" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ALine}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="ChipArrowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Margin" Value="0,-5,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AT70}"/>
        </Style>
        <Style x:Key="LiveBadge" TargetType="Border">
            <Setter Property="Background" Value="#E5484D"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,2,8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Width="1920" Height="1080" ClipToBounds="True">

        <!-- ============ 時間帯の空の光（色と強さはコードで設定。動かさない） -->
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="SkyTopLeft" Canvas.Left="-250" Canvas.Top="-350" Width="1300" Height="1000" Opacity="0"/>
            <Ellipse x:Name="SkyTopRight" Canvas.Left="800" Canvas.Top="-460" Width="1500" Height="1100" Opacity="0"/>
            <Ellipse x:Name="SkyBottomLeft" Canvas.Left="-300" Canvas.Top="520" Width="1500" Height="1000" Opacity="0"/>
            <Ellipse x:Name="SkyBottomRight" Canvas.Left="1050" Canvas.Top="520" Width="1300" Height="900" Opacity="0"/>
        </Canvas>

        <!-- ============ 背景の光（CPU＝青緑、GPU＝紫、高温＝赤） -->
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="BlobCpu" Canvas.Left="-380" Canvas.Top="300" Width="1300" Height="1100" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#C01D8FA6" Offset="0"/>
                        <GradientStop Color="#401D8FA6" Offset="0.45"/>
                        <GradientStop Color="#001D8FA6" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BlobGpu" Canvas.Left="680" Canvas.Top="-420" Width="1550" Height="1350" Opacity="0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#C06A4BD8" Offset="0"/>
                        <GradientStop Color="#406A4BD8" Offset="0.45"/>
                        <GradientStop Color="#006A4BD8" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BlobHeat" Canvas.Left="1150" Canvas.Top="380" Width="1150" Height="1000" Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A0D2553F" Offset="0"/>
                        <GradientStop Color="#30D2553F" Offset="0.45"/>
                        <GradientStop Color="#00D2553F" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <!-- 再生中の曲のジャケット色（色はコードで設定） -->
            <Ellipse x:Name="BlobMusic" Canvas.Left="80" Canvas.Top="530" Width="900" Height="520" Opacity="0">
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
        <Rectangle x:Name="Vignette" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#00000000" Offset="0.45"/>
                    <GradientStop Color="#80000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============ 左上：注意書き -->
        <TextBlock x:Name="Notice" Margin="110,84,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                   FontFamily="{StaticResource UiFont}" FontSize="19" Foreground="{StaticResource Warn}"/>

        <!-- 時計・日付・天気（Twitch の拡張表示の間は DailyLayer ごと隠す） -->
        <Grid x:Name="DailyLayer">
        <!-- ============ 主役：時計 -->
        <TextBlock x:Name="ClockText" Margin="90,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                   FontFamily="{StaticResource NumFont}" FontWeight="Light" FontSize="300" Foreground="{DynamicResource AText}"
                   Typography.NumeralAlignment="Tabular" Text="00:00"/>
        <TextBlock x:Name="DateText" Margin="112,470,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                   FontFamily="{StaticResource UiFont}" FontSize="34" Foreground="{DynamicResource AT80}"/>

        <!-- ============ 天気 -->
        <Border x:Name="WeatherCard" Style="{StaticResource Glass}" Background="{DynamicResource AGlass}" BorderBrush="{DynamicResource ALine}" Margin="96,556,0,0" Width="860" Height="200"
                HorizontalAlignment="Left" VerticalAlignment="Top" Padding="30,22,30,22">
            <Grid>
                <Grid x:Name="WeatherBody">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <c:WeatherIcon x:Name="NowIcon" Width="96" Height="96"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NowTemp" FontFamily="{StaticResource NumFont}" FontWeight="Light" FontSize="66"
                                       Foreground="{DynamicResource AText}" Text="--"/>
                            <TextBlock FontFamily="{StaticResource UiFont}" FontSize="20" Foreground="{DynamicResource AT70}" Margin="0,2,0,0">
                                <Run x:Name="NowText"/><Run Text="　"/><Run x:Name="NowRange" FontFamily="{StaticResource NumFont}"/>
                            </TextBlock>
                            <TextBlock x:Name="Place" FontFamily="{StaticResource UiFont}" FontSize="17" Foreground="{DynamicResource AT50}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource ALine}" Margin="30,0,24,0"/>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                    <StackPanel x:Name="Hour0" Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock x:Name="Hour0Time" Style="{StaticResource HourTime}" Foreground="{DynamicResource AT60}" Text=" "/>
                        <c:WeatherIcon x:Name="Hour0Icon" Width="52" Height="52" Margin="0,4,0,2"/>
                        <TextBlock x:Name="Hour0Temp" Style="{StaticResource HourTemp}" Foreground="{DynamicResource AText}" Text=" "/>
                        <TextBlock x:Name="Hour0Rain" Style="{StaticResource HourRain}" Foreground="{DynamicResource ARain}" Text=" "/>
                    </StackPanel>
                    <StackPanel x:Name="Hour1" Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="Hour1Time" Style="{StaticResource HourTime}" Foreground="{DynamicResource AT60}" Text=" "/>
                        <c:WeatherIcon x:Name="Hour1Icon" Width="52" Height="52" Margin="0,4,0,2"/>
                        <TextBlock x:Name="Hour1Temp" Style="{StaticResource HourTemp}" Foreground="{DynamicResource AText}" Text=" "/>
                        <TextBlock x:Name="Hour1Rain" Style="{StaticResource HourRain}" Foreground="{DynamicResource ARain}" Text=" "/>
                    </StackPanel>
                    <StackPanel x:Name="Hour2" Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="Hour2Time" Style="{StaticResource HourTime}" Foreground="{DynamicResource AT60}" Text=" "/>
                        <c:WeatherIcon x:Name="Hour2Icon" Width="52" Height="52" Margin="0,4,0,2"/>
                        <TextBlock x:Name="Hour2Temp" Style="{StaticResource HourTemp}" Foreground="{DynamicResource AText}" Text=" "/>
                        <TextBlock x:Name="Hour2Rain" Style="{StaticResource HourRain}" Foreground="{DynamicResource ARain}" Text=" "/>
                    </StackPanel>
                    <StackPanel x:Name="Hour3" Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock x:Name="Hour3Time" Style="{StaticResource HourTime}" Foreground="{DynamicResource AT60}" Text=" "/>
                        <c:WeatherIcon x:Name="Hour3Icon" Width="52" Height="52" Margin="0,4,0,2"/>
                        <TextBlock x:Name="Hour3Temp" Style="{StaticResource HourTemp}" Foreground="{DynamicResource AText}" Text=" "/>
                        <TextBlock x:Name="Hour3Rain" Style="{StaticResource HourRain}" Foreground="{DynamicResource ARain}" Text=" "/>
                    </StackPanel>
                    <StackPanel x:Name="Hour4" Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="Hour4Time" Style="{StaticResource HourTime}" Foreground="{DynamicResource AT60}" Text=" "/>
                        <c:WeatherIcon x:Name="Hour4Icon" Width="52" Height="52" Margin="0,4,0,2"/>
                        <TextBlock x:Name="Hour4Temp" Style="{StaticResource HourTemp}" Foreground="{DynamicResource AText}" Text=" "/>
                        <TextBlock x:Name="Hour4Rain" Style="{StaticResource HourRain}" Foreground="{DynamicResource ARain}" Text=" "/>
                    </StackPanel>
                    <StackPanel x:Name="Hour5" Grid.Column="5" HorizontalAlignment="Center">
                        <TextBlock x:Name="Hour5Time" Style="{StaticResource HourTime}" Foreground="{DynamicResource AT60}" Text=" "/>
                        <c:WeatherIcon x:Name="Hour5Icon" Width="52" Height="52" Margin="0,4,0,2"/>
                        <TextBlock x:Name="Hour5Temp" Style="{StaticResource HourTemp}" Foreground="{DynamicResource AText}" Text=" "/>
                        <TextBlock x:Name="Hour5Rain" Style="{StaticResource HourRain}" Foreground="{DynamicResource ARain}" Text=" "/>
                    </StackPanel>
                    </Grid>
                </Grid>
                <TextBlock x:Name="WeatherMessage" FontFamily="{StaticResource UiFont}" FontSize="22" Foreground="{DynamicResource AT60}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Text="天気を取得しています"/>
            </Grid>
        </Border>

        </Grid>

        <!-- ============ メディアカード：ニュース（ダブルクリックで記事を開く）。上は画面の上端近く、左は天気カードの右、下は下段のバーの手前まで -->
        <Border x:Name="NewsCard" Style="{StaticResource Glass}" Background="{DynamicResource AGlass}" BorderBrush="{DynamicResource ALine}" Margin="0,48,96,0" Width="844" Height="804"
                HorizontalAlignment="Right" VerticalAlignment="Top" Padding="42,34,42,30" Cursor="Hand"
                ToolTip="ダブルクリックで記事を開く">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource AAccent}" VerticalAlignment="Center" Margin="0,2,12,0"/>
                        <TextBlock x:Name="NewsSource" FontFamily="{StaticResource UiFont}" FontSize="21" Foreground="{DynamicResource AT70}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="NewsAge" VerticalAlignment="Center" FontFamily="{StaticResource NumFont}" FontSize="21" Foreground="{DynamicResource AT70}"/>
                        <!-- Twitch・YouTube に切り替え（使う設定のものだけ出す） -->
                        <Border x:Name="NewsSeg" Margin="18,-6,0,-6" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource ALine}" Padding="3"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SegTab}" Background="{DynamicResource ALine}">
                                    <TextBlock Style="{StaticResource SegText}" Text="ニュース" Foreground="{DynamicResource AText}"/>
                                </Border>
                                <Border x:Name="NewsTabTwitch" Style="{StaticResource SegTab}" Cursor="Hand" ToolTip="Twitch に切り替える">
                                    <TextBlock Style="{StaticResource SegText}" Text="Twitch" Foreground="{DynamicResource AT60}"/>
                                </Border>
                                <Border x:Name="NewsTabYouTube" Style="{StaticResource SegTab}" Cursor="Hand" ToolTip="YouTube に切り替える">
                                    <TextBlock Style="{StaticResource SegText}" Text="YouTube" Foreground="{DynamicResource AT60}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="NewsTitle" Grid.Row="1" Margin="0,24,0,0" FontFamily="{StaticResource UiFont}" FontSize="46"
                           FontWeight="Medium" Foreground="{DynamicResource AText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineHeight="66" LineStackingStrategy="BlockLineHeight" MaxHeight="200"/>
                <!-- 見出しの下に本文の要約。行数は空いている高さに合わせてコードで決める（最大4行） -->
                <Grid x:Name="NewsBody" Grid.Row="2">
                    <Grid x:Name="NewsPreviewBox" VerticalAlignment="Top" Margin="0,22,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{DynamicResource AAccent}" Opacity="0.6" RadiusX="1.5" RadiusY="1.5" Margin="0,6,0,6"/>
                        <TextBlock x:Name="NewsPreview" Grid.Column="1" Margin="17,0,0,0" FontFamily="{StaticResource UiFont}" FontSize="26"
                                   Foreground="{DynamicResource AT70}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   LineHeight="44" LineStackingStrategy="BlockLineHeight"/>
                    </Grid>
                    <StackPanel x:Name="NewsNext" VerticalAlignment="Bottom" Margin="0,0,0,24"/>
                </Grid>
                <Grid Grid.Row="3">
                    <StackPanel x:Name="NewsDots" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- 前へ・次へ（マウスを乗せたときの背景はコードで設定） -->
                        <StackPanel x:Name="NewsNav" Orientation="Horizontal" Margin="0,-8,24,-8">
                            <Border x:Name="NewsPrev" Style="{StaticResource NewsButton}" ToolTip="前のニュース" BorderBrush="{DynamicResource AT40}">
                                <Path Data="M7,0 L0,7 L7,14" Stroke="{DynamicResource AT85}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                            <Border x:Name="NewsNextButton" Style="{StaticResource NewsButton}" ToolTip="次のニュース" BorderBrush="{DynamicResource AT40}" Margin="10,0,0,0">
                                <Path Data="M0,0 L7,7 L0,14" Stroke="{DynamicResource AT85}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="NewsCount" FontFamily="{StaticResource NumFont}" FontSize="19" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AT50}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ Twitch・YouTube（ニュースと手動で切り替え。起動時はニュース）。映像の場所（TwitchSlot）に WebView2 を重ねる。
             どちらも同じカードを使い、選んでいる方のタブの色はコードで付ける -->
        <Border x:Name="TwitchCard" Style="{StaticResource Glass}" Background="{DynamicResource AGlass}" BorderBrush="{DynamicResource ALine}" Margin="0,48,96,0" Width="844" Height="804"
                HorizontalAlignment="Right" VerticalAlignment="Top" Padding="42,30,42,30" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Border CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource ALine}" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="TwitchTabNews" Style="{StaticResource SegTab}" Cursor="Hand" ToolTip="ニュースに戻す">
                                <TextBlock Style="{StaticResource SegText}" Text="ニュース" Foreground="{DynamicResource AT60}"/>
                            </Border>
                            <Border x:Name="CardTabTwitch" Style="{StaticResource SegTab}" Cursor="Hand" ToolTip="Twitch に切り替える">
                                <TextBlock Style="{StaticResource SegText}" Text="Twitch"/>
                            </Border>
                            <Border x:Name="CardTabYouTube" Style="{StaticResource SegTab}" Cursor="Hand" ToolTip="YouTube に切り替える">
                                <TextBlock Style="{StaticResource SegText}" Text="YouTube"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel x:Name="TwitchLiveInfo" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Style="{StaticResource LiveBadge}">
                                <TextBlock Text="LIVE" FontFamily="{StaticResource NumFont}" FontWeight="SemiBold" FontSize="15" Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="TwitchViewers" Margin="12,0,0,0" FontFamily="{StaticResource NumFont}" FontSize="20"
                                       Foreground="{DynamicResource AT70}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TwitchUptime" Margin="12,0,0,0" FontFamily="{StaticResource NumFont}" FontSize="20"
                                       Foreground="{DynamicResource AT50}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                        <Border x:Name="CardUrl" Style="{StaticResource CardButton}" BorderBrush="{DynamicResource AT40}" Margin="16,-4,0,-4"
                                ToolTip="コピーした YouTube の URL を再生" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SegText}" Text="＋ URL" Foreground="{DynamicResource AT85}"/>
                        </Border>
                        <Border x:Name="TwitchExpand" Style="{StaticResource CardButton}" BorderBrush="{DynamicResource AT40}" Margin="12,-4,0,-4"
                                ToolTip="拡張表示（チャット付き）">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M0,6 V0 H6 M10,0 H16 V6 M16,10 V16 H10 M6,16 H0 V10" Stroke="{DynamicResource AT85}" StrokeThickness="2"
                                      Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource SegText}" Text="拡張" Margin="8,0,0,0" Foreground="{DynamicResource AT85}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <!-- 映像（WebView2 を上に重ねる。映像がないときはメッセージ） -->
                <Border x:Name="TwitchSlot" Grid.Row="1" Margin="0,20,0,0" Width="760" Height="428" Background="#0E0E14">
                    <TextBlock x:Name="TwitchMessage" Margin="40,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" FontFamily="{StaticResource UiFont}" FontSize="22" LineHeight="36" Foreground="#B3F4F7FB"/>
                </Border>
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="TwitchAvatar" Width="56" Height="56" Fill="{DynamicResource ALine}"/>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TwitchName" FontFamily="{StaticResource UiFont}" FontSize="29" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TwitchTitle" Margin="0,4,0,0" FontFamily="{StaticResource UiFont}" FontSize="19"
                                   Foreground="{DynamicResource AT60}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="4">
                    <TextBlock x:Name="TwitchListLabel" FontFamily="{StaticResource UiFont}" FontSize="17" Foreground="{DynamicResource AT50}"/>
                    <!-- 入りきらないときは左右の矢印かマウスホイールで横に送る -->
                    <Grid Margin="0,10,0,0" Height="58">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TwitchChipsLeft" Style="{StaticResource ChipArrow}" Margin="0,0,10,0" ToolTip="前のチャンネル">
                            <TextBlock Style="{StaticResource ChipArrowText}" Text="‹"/>
                        </Border>
                        <ScrollViewer x:Name="TwitchChipsScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="TwitchChips" Orientation="Horizontal"/>
                        </ScrollViewer>
                        <Border x:Name="TwitchChipsRight" Grid.Column="2" Style="{StaticResource ChipArrow}" Margin="10,0,0,0" ToolTip="次のチャンネル">
                            <TextBlock Style="{StaticResource ChipArrowText}" Text="›"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 再生中の曲（Spotify など）。天気の下に出す。何も再生していないときは隠す（Twitch の拡張表示の間は MediaLayer ごと隠す） -->
        <Grid x:Name="MediaLayer">
        <Border x:Name="MediaCard" Style="{StaticResource Glass}" Background="{DynamicResource AGlass}" BorderBrush="{DynamicResource ALine}" Margin="96,726,0,0" Width="860" Height="126"
                HorizontalAlignment="Left" VerticalAlignment="Top" Padding="15,15,20,15" Visibility="Collapsed">
            <Grid x:Name="MediaBody">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- ジャケット（画像がないときは音符） -->
                <Border x:Name="MediaArt" Width="96" Height="96" CornerRadius="12" Background="{DynamicResource ALine}">
                    <Path x:Name="MediaArtNote" Width="34" Height="40" Stretch="Uniform" Fill="{DynamicResource AT50}"
                          Data="M9,0 L24,4 L24,10 L12,7 L12,24 A5,5 0 1 1 9,20 Z"/>
                </Border>
                <Grid Grid.Column="1" Margin="22,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="MediaDot" Width="10" Height="10" Fill="#1ED760" VerticalAlignment="Center" Margin="0,1,10,0"/>
                        <TextBlock x:Name="MediaSource" FontFamily="{StaticResource UiFont}" FontSize="19" Foreground="{DynamicResource AT60}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-8,0,-8">
                        <Border x:Name="MediaPrev" Style="{StaticResource MediaButton}" ToolTip="前の曲">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AT70}" Data="M0,0 H3 V14 H0 Z M16,0 V14 L4,7 Z"/>
                        </Border>
                        <Border x:Name="MediaPlayPause" Style="{StaticResource MediaButton}" ToolTip="再生／一時停止">
                            <Grid>
                                <Path x:Name="MediaPauseIcon" Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource AText}"
                                      Data="M0,0 H5 V18 H0 Z M10,0 H15 V18 H10 Z"/>
                                <Path x:Name="MediaPlayIcon" Width="18" Height="20" Stretch="Uniform" Fill="{DynamicResource AText}"
                                      Data="M0,0 L16,9 L0,18 Z" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Border x:Name="MediaNext" Style="{StaticResource MediaButton}" ToolTip="次の曲">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AT70}" Data="M13,0 H16 V14 H13 Z M0,0 V14 L12,7 Z"/>
                        </Border>
                    </StackPanel>
                    <!-- 曲名とアーティスト・アルバムを1行で -->
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource UiFont}">
                        <Run x:Name="MediaTitle" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource AText}"/><Run x:Name="MediaSub" FontSize="20" Foreground="{DynamicResource AT70}"/>
                    </TextBlock>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MediaPos" FontFamily="{StaticResource NumFont}" FontSize="17" Foreground="{DynamicResource AT60}"
                                   Typography.NumeralAlignment="Tabular" MinWidth="40"/>
                        <Grid x:Name="MediaTrack" Grid.Column="1" Height="12" Margin="14,0,14,0" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource ALine}"/>
                            <Border x:Name="MediaFill" Height="4" CornerRadius="2" Background="{DynamicResource AText}" HorizontalAlignment="Left" Width="0"/>
                            <Ellipse x:Name="MediaKnob" Width="12" Height="12" Fill="{DynamicResource AText}" HorizontalAlignment="Left"/>
                        </Grid>
                        <TextBlock x:Name="MediaDur" Grid.Column="2" FontFamily="{StaticResource NumFont}" FontSize="17" Foreground="{DynamicResource AT60}"
                                   Typography.NumeralAlignment="Tabular"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        </Grid>

        <!-- ============ Twitch・YouTube の拡張表示（時計・天気・再生中の曲の場所まで広げ、映像の右にチャットなどを出す） -->
        <Border x:Name="TwitchWide" Style="{StaticResource Glass}" Background="{DynamicResource AGlass}" BorderBrush="{DynamicResource ALine}" Margin="96,124,96,0" Height="734"
                VerticalAlignment="Top" Padding="28,20,28,20" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource ALine}" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="WideTabNews" Style="{StaticResource SegTab}" Cursor="Hand" ToolTip="ニュースに戻す">
                                    <TextBlock Style="{StaticResource SegText}" Text="ニュース" Foreground="{DynamicResource AT60}"/>
                                </Border>
                                <Border x:Name="WideTabTwitch" Style="{StaticResource SegTab}" Cursor="Hand" ToolTip="Twitch に切り替える">
                                    <TextBlock Style="{StaticResource SegText}" Text="Twitch"/>
                                </Border>
                                <Border x:Name="WideTabYouTube" Style="{StaticResource SegTab}" Cursor="Hand" ToolTip="YouTube に切り替える">
                                    <TextBlock Style="{StaticResource SegText}" Text="YouTube"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Ellipse x:Name="WideAvatar" Width="40" Height="40" Margin="22,0,0,0" Fill="{DynamicResource ALine}"/>
                        <TextBlock x:Name="WideName" Margin="14,0,0,0" FontFamily="{StaticResource UiFont}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AText}" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="WideTitle" Margin="16,0,0,0" FontFamily="{StaticResource UiFont}" FontSize="19"
                                   Foreground="{DynamicResource AT60}" VerticalAlignment="Center" MaxWidth="500" TextTrimming="CharacterEllipsis"/>
                        <StackPanel x:Name="WideLiveInfo" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed">
                            <Border Style="{StaticResource LiveBadge}">
                                <TextBlock Text="LIVE" FontFamily="{StaticResource NumFont}" FontWeight="SemiBold" FontSize="15" Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="WideViewers" Margin="12,0,0,0" FontFamily="{StaticResource NumFont}" FontSize="20"
                                       Foreground="{DynamicResource AT70}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WideUptime" Margin="12,0,0,0" FontFamily="{StaticResource NumFont}" FontSize="20"
                                       Foreground="{DynamicResource AT50}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="WideUrl" Style="{StaticResource CardButton}" BorderBrush="{DynamicResource AT40}" Margin="20,0,0,0"
                                VerticalAlignment="Center" ToolTip="コピーした YouTube の URL を再生" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SegText}" Text="＋ URL" Foreground="{DynamicResource AT85}"/>
                        </Border>
                        <Border x:Name="WideCollapse" Style="{StaticResource CardButton}" BorderBrush="{DynamicResource AT40}" Margin="12,0,0,0"
                                VerticalAlignment="Center" ToolTip="通常の大きさに戻す">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M6,0 V6 H0 M16,6 H10 V0 M10,16 V10 H16 M0,10 H6 V16" Stroke="{DynamicResource AT85}" StrokeThickness="2"
                                      Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource SegText}" Text="通常表示" Margin="8,0,0,0" Foreground="{DynamicResource AT85}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <!-- 映像＋チャット（WebView2 を上に重ねる） -->
                <Border x:Name="WideSlot" Grid.Row="1" Margin="0,16,0,0" Background="#0E0E14">
                    <TextBlock x:Name="WideMessage" Margin="40,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" FontFamily="{StaticResource UiFont}" FontSize="24" LineHeight="38" Foreground="#B3F4F7FB"/>
                </Border>
                <Grid Grid.Row="2" Margin="0,14,0,0" Height="58">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="WideListLabel" FontFamily="{StaticResource UiFont}" FontSize="17" Foreground="{DynamicResource AT50}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border x:Name="WideChipsLeft" Grid.Column="1" Style="{StaticResource ChipArrow}" Margin="0,0,10,0" ToolTip="前のチャンネル">
                        <TextBlock Style="{StaticResource ChipArrowText}" Text="‹"/>
                    </Border>
                    <ScrollViewer x:Name="WideChipsScroll" Grid.Column="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="WideChips" Orientation="Horizontal"/>
                    </ScrollViewer>
                    <Border x:Name="WideChipsRight" Grid.Column="3" Style="{StaticResource ChipArrow}" Margin="10,0,0,0" ToolTip="次のチャンネル">
                        <TextBlock Style="{StaticResource ChipArrowText}" Text="›"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 拡張表示の間だけ、時計と気温を画面の右上（カードの外）に出す -->
        <StackPanel x:Name="WideClockPanel" Orientation="Horizontal" Margin="0,14,96,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="WideClock" FontFamily="{StaticResource NumFont}" FontWeight="Light" FontSize="84" Foreground="{DynamicResource AText}"
                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
            <TextBlock x:Name="WideTemp" Margin="22,10,0,0" FontFamily="{StaticResource NumFont}" FontSize="34" Foreground="{DynamicResource AT70}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ============ PC の状態：控えめな1本のバー -->
        <Border Style="{StaticResource Glass}" Background="{DynamicResource AGlass}" BorderBrush="{DynamicResource ALine}"
                Margin="96,0,96,84" Height="120" VerticalAlignment="Bottom">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="26,0,26,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource BarLabel}" Foreground="{DynamicResource AT60}"/>
                            <TextBlock x:Name="CpuValue" Style="{StaticResource BarValue}" Foreground="{DynamicResource ACpu}" Text="--"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="CpuSide" Style="{StaticResource BarSide}" Foreground="{DynamicResource AT50}" Text=" "/>
                            <c:HistoryChart x:Name="CpuChart" Width="120" Height="30" Margin="0,6,0,0" Stroke="#7FE3F0"
                                            SecondStroke="#66F4F7FB" Max="100" ShowGrid="False" FillOpacity="0" LineThickness="1.8"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" BorderBrush="{DynamicResource ALine}" BorderThickness="1,0,0,0" Padding="26,0,26,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="GPU" Style="{StaticResource BarLabel}" Foreground="{DynamicResource AT60}"/>
                            <TextBlock x:Name="GpuValue" Style="{StaticResource BarValue}" Foreground="{DynamicResource AGpu}" Text="--"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="GpuSide" Style="{StaticResource BarSide}" Foreground="{DynamicResource AT50}" Text=" "/>
                            <c:HistoryChart x:Name="GpuChart" Width="120" Height="30" Margin="0,6,0,0" Stroke="#B7A6FF"
                                            SecondStroke="#66F4F7FB" Max="100" ShowGrid="False" FillOpacity="0" LineThickness="1.8"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" BorderBrush="{DynamicResource ALine}" BorderThickness="1,0,0,0" Padding="26,0,26,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="メモリ" Style="{StaticResource BarLabel}" Foreground="{DynamicResource AT60}"/>
                            <TextBlock x:Name="MemValue" Style="{StaticResource BarValue}" Foreground="{DynamicResource AText}" Text="--"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="MemSide" Style="{StaticResource BarSide}" Foreground="{DynamicResource AT50}" Text=" "/>
                            <c:HistoryChart x:Name="MemChart" Width="120" Height="30" Margin="0,6,0,0" Stroke="#F4F7FB"
                                            SecondStroke="#66F4F7FB" Max="100" ShowGrid="False" FillOpacity="0" LineThickness="1.8"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="3" BorderBrush="{DynamicResource ALine}" BorderThickness="1,0,0,0" Padding="26,0,26,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="VRAM" Style="{StaticResource BarLabel}" Foreground="{DynamicResource AT60}"/>
                            <TextBlock x:Name="VramValue" Style="{StaticResource BarValue}" Foreground="{DynamicResource AText}" Text="--"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="VramSide" Style="{StaticResource BarSide}" Foreground="{DynamicResource AT50}" Text=" "/>
                            <c:HistoryChart x:Name="VramChart" Width="120" Height="30" Margin="0,6,0,0" Stroke="#F4F7FB"
                                            SecondStroke="#66F4F7FB" Max="100" ShowGrid="False" FillOpacity="0" LineThickness="1.8"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="4" BorderBrush="{DynamicResource ALine}" BorderThickness="1,0,0,0" Padding="26,0,26,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ネット" Style="{StaticResource BarLabel}" Foreground="{DynamicResource AT60}"/>
                            <TextBlock x:Name="NetValue" Style="{StaticResource BarValue}" Foreground="{DynamicResource AText}" Text="--"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="NetSide" Style="{StaticResource BarSide}" Foreground="{DynamicResource AT50}" Text=" "/>
                            <c:HistoryChart x:Name="NetChart" Width="120" Height="30" Margin="0,6,0,0" Stroke="#F4F7FB"
                                            SecondStroke="#66F4F7FB" Max="100" ShowGrid="False" FillOpacity="0" LineThickness="1.8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============ テーマ切替（メディアカードの右、画面の右端に縦並び）。四角は各テーマの空の色。
             クリックでそのテーマに固定、固定中のものをもう一度クリックで自動（時間帯）に戻す -->
        <StackPanel x:Name="ThemePicker" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,14,0" Width="68">
            <TextBlock x:Name="ThemeAuto" Text="自動" FontSize="15" Foreground="{DynamicResource AT50}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <Border Background="{DynamicResource AGlass}" BorderBrush="{DynamicResource ALine}" BorderThickness="1"
                    CornerRadius="16" Padding="6,4">
                <StackPanel>
                    <!-- 朝 -->
                    <Border x:Name="ThemeMorning" Tag="morning" ToolTip="朝" Width="54" Height="54" CornerRadius="14"
                            BorderThickness="2" Padding="2" Background="Transparent" Cursor="Hand">
                        <Grid>
                            <Rectangle RadiusX="11" RadiusY="11">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C9DDF2" Offset="0"/>
                                        <GradientStop Color="#EBDCE0" Offset="0.5"/>
                                        <GradientStop Color="#FAD9BE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="11" RadiusY="11">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="0.15,1" GradientOrigin="0.15,1" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Color="#D9FFB774" Offset="0"/>
                                        <GradientStop Color="#00FFB774" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="11" RadiusY="11">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Color="#8C9CCBF2" Offset="0"/>
                                        <GradientStop Color="#009CCBF2" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Path Width="28" Height="28" Stretch="None" Stroke="#E2793A" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M7,19 A7,7 0 0 1 21,19 M3,23 L25,23 M14,3 L14,8 M11,6 L14,3 L17,6"/>
                        </Grid>
                    </Border>
                    <!-- 昼 -->
                    <Border x:Name="ThemeDay" Tag="day" ToolTip="昼" Width="54" Height="54" CornerRadius="14"
                            BorderThickness="2" Padding="2" Background="Transparent" Cursor="Hand">
                        <Grid>
                            <Rectangle RadiusX="11" RadiusY="11">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#6FB8EE" Offset="0"/>
                                        <GradientStop Color="#A8D8F6" Offset="0.5"/>
                                        <GradientStop Color="#E4F3FC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="11" RadiusY="11">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="0.55" RadiusY="0.55">
                                        <GradientStop Color="#D9FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="11" RadiusY="11">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="0.15,1" GradientOrigin="0.15,1" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Color="#737FE0D8" Offset="0"/>
                                        <GradientStop Color="#007FE0D8" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Path Width="28" Height="28" Stretch="None" Fill="#FFD45A" Stroke="#F2A900" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M8.5,14 A5.5,5.5 0 1 1 19.5,14 A5.5,5.5 0 1 1 8.5,14 Z"/>
                            <Path Width="28" Height="28" Stretch="None" Stroke="#F2A900" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M14,2 L14,5 M14,23 L14,26 M2,14 L5,14 M23,14 L26,14 M5.5,5.5 L7.6,7.6 M20.4,20.4 L22.5,22.5 M5.5,22.5 L7.6,20.4 M20.4,7.6 L22.5,5.5"/>
                        </Grid>
                    </Border>
                    <!-- 夕方 -->
                    <Border x:Name="ThemeEvening" Tag="evening" ToolTip="夕方" Width="54" Height="54" CornerRadius="14"
                            BorderThickness="2" Padding="2" Background="Transparent" Cursor="Hand">
                        <Grid>
                            <Rectangle RadiusX="11" RadiusY="11">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2A1A44" Offset="0"/>
                                        <GradientStop Color="#3A1D3E" Offset="0.5"/>
                                        <GradientStop Color="#4A2230" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="11" RadiusY="11">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Color="#99F07A3A" Offset="0"/>
                                        <GradientStop Color="#00F07A3A" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="11" RadiusY="11">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="0,1" GradientOrigin="0,1" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Color="#80C2468E" Offset="0"/>
                                        <GradientStop Color="#00C2468E" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="11" RadiusY="11">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Color="#806A4BD8" Offset="0"/>
                                        <GradientStop Color="#006A4BD8" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Path Width="28" Height="28" Stretch="None" Stroke="#FFB38A" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M7,19 A7,7 0 0 1 21,19 M3,23 L25,23 M14,3 L14,8 M11,5 L14,8 L17,5"/>
                        </Grid>
                    </Border>
                    <!-- 夜 -->
                    <Border x:Name="ThemeNight" Tag="night" ToolTip="夜" Width="54" Height="54" CornerRadius="14"
                            BorderThickness="2" Padding="2" Background="Transparent" Cursor="Hand">
                        <Grid>
                            <Rectangle RadiusX="11" RadiusY="11" Stroke="#24FFFFFF" StrokeThickness="1">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#06080F" Offset="0"/>
                                        <GradientStop Color="#070912" Offset="0.5"/>
                                        <GradientStop Color="#05060B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="11" RadiusY="11">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.65" RadiusY="0.65">
                                        <GradientStop Color="#8C2B3480" Offset="0"/>
                                        <GradientStop Color="#002B3480" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle RadiusX="11" RadiusY="11">
                                <Rectangle.Fill>
                                    <RadialGradientBrush Center="0,1" GradientOrigin="0,1" RadiusX="0.6" RadiusY="0.6">
                                        <GradientStop Color="#73173C5A" Offset="0"/>
                                        <GradientStop Color="#00173C5A" Offset="1"/>
                                    </RadialGradientBrush>
