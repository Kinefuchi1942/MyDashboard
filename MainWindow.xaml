<Window x:Class="MyDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyDashboard"
        Icon="pack://application:,,,/app.ico"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True" ShowActivated="False"
        Background="{StaticResource Ground}"
        Width="1280" Height="720"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextRenderingMode="ClearType">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="レイアウト">
                <MenuItem x:Name="LayoutClassicItem" Header="標準" IsCheckable="True" Tag="classic" Click="OnLayoutMenu"/>
                <MenuItem x:Name="LayoutGaugeItem" Header="計器盤" IsCheckable="True" Tag="gauge" Click="OnLayoutMenu"/>
                <MenuItem x:Name="LayoutAuroraItem" Header="オーロラ" IsCheckable="True" Tag="aurora" Click="OnLayoutMenu"/>
                <Separator/>
                <MenuItem Header="次のレイアウト" InputGestureText="L" Click="OnNextLayout"/>
            </MenuItem>
            <MenuItem Header="次のモニターへ移動" InputGestureText="M" Click="OnNextMonitor"/>
            <MenuItem x:Name="BehindItem" Header="常に背後に表示" IsCheckable="True" InputGestureText="B" Click="OnToggleBehind"/>
            <MenuItem Header="設定…" InputGestureText="S" Click="OnOpenSettingsWindow"/>
            <MenuItem Header="設定ファイルを開く" Click="OnOpenSettings"/>
            <Separator/>
            <MenuItem Header="終了" InputGestureText="Ctrl+Q" Click="OnQuit"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- 各レイアウトは 1920×1080 で設計し、モニターの解像度に合わせて拡大縮小する -->
    <Viewbox Stretch="Uniform">
        <ContentControl x:Name="Host" Width="1920" Height="1080" Focusable="False"/>
    </Viewbox>
</Window>
