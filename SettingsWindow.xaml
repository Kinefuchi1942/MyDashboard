                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                                        <Button Style="{StaticResource IconBtn}" Content="▲" Tag="{Binding}" Click="OnFeedUp" ToolTip="上へ"/>
                                                        <Button Style="{StaticResource IconBtn}" Content="▼" Tag="{Binding}" Click="OnFeedDown" ToolTip="下へ"/>
                                                    </StackPanel>
                                                    <TextBox Grid.Column="1" Margin="0,0,10,0" Padding="10,5" FontSize="14"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Column="2" Padding="10,5" FontSize="13" Foreground="{StaticResource Soft}"
                                                             Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Grid.Column="3" Style="{StaticResource IconBtn}" Content="✕" Margin="8,0,0,0"
                                                            Tag="{Binding}" Click="OnFeedRemove" ToolTip="削除"/>
