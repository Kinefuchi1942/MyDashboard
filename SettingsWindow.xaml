                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Label}" Text="80 PLUS の等級"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="効率から、コンセント側の電力を出します"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" x:Name="PsuRatingPanel" Margin="0,10,0,0">
