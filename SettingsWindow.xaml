                                    <TextBox x:Name="GpuWarnBox" Style="{StaticResource NumBox}" BorderBrush="#80FFB547"/>
                                    <TextBlock Text="°C" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBox x:Name="GpuCritBox" Style="{StaticResource NumBox}" BorderBrush="#80FF5D5D"/>
                                    <TextBlock Text="°C" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
