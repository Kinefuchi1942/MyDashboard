                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Label}" Text="ゲーム中は低画質"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="ゲームが続いている間、配信を 360p 程度に下げます（初期値はオフ）"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="TwitchLowBox" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= YouTube -->
                    <StackPanel x:Name="PageYouTube" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="YouTube"/>
                        <TextBlock Style="{StaticResource Lead}" Text="オーロラのニュースカードを、登録したチャンネルの配信と新着動画に切り替えられます（登録やキーは不要）"/>

                        <Border Style="{StaticResource RowLine}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Label}" Text="YouTube を使う"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="ニュースカードに「YouTube」の切り替えを出します"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="YouTubeBox" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="チャンネル"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,14"
                                           Text="チャンネルの URL（youtube.com/@〇〇）、@ハンドル、その人の動画の URL のどれかを入れて「追加」を押します"/>
                                <ItemsControl x:Name="YouTubeList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Rule}" BorderThickness="1"
                                                    CornerRadius="8" Padding="14,4,4,4" Margin="0,0,10,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource Soft}" ToolTip="{Binding Id}"/>
                                                    <Button Style="{StaticResource IconBtn}" Content="✕" Tag="{Binding}" Click="OnYouTubeRemove"
                                                            Margin="4,0,0,0" ToolTip="登録をやめる"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBox x:Name="YouTubeInput" Width="360" KeyDown="OnYouTubeKey"/>
                                    <Button x:Name="YouTubeAddButton" Style="{StaticResource Btn}" Content="＋ 追加" Padding="18,8" Margin="10,0,0,0"
                                            Foreground="{StaticResource Accent}" Click="OnYouTubeAdd"/>
                                </StackPanel>
                                <TextBlock x:Name="YouTubeStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="使い方"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="配信中のチャンネルが一覧の先頭に、そのあとに新着動画が並びます。カード右上の「＋ URL」を押すと、コピーしておいた YouTube の動画の URL を再生します。動画が終わったら止まります"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= FPS -->
                    <StackPanel x:Name="PageFps" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="FPS"/>
                        <TextBlock Style="{StaticResource Lead}" Text="Intel PresentMon で計測します（publish フォルダに PresentMon.exe が必要）"/>

                        <Border Style="{StaticResource RowLine}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="FPS を計測"/>
                                <CheckBox Grid.Column="1" x:Name="FpsBox" Style="{StaticResource Switch}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource RowLine}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="計測しないアプリ"/>
                                <TextBlock Style="{StaticResource Hint}" Text="ゲーム以外で FPS が出てしまうアプリを除外します（例：chrome.exe）"
                                           Margin="0,3,0,14"/>
                                <ItemsControl x:Name="ExcludeList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Rule}" BorderThickness="1"
                                                    CornerRadius="8" Padding="14,4,4,4" Margin="0,0,10,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="{StaticResource Soft}"/>
                                                    <Button Style="{StaticResource IconBtn}" Content="✕" Tag="{Binding}" Click="OnExcludeRemove"
                                                            Margin="4,0,0,0" ToolTip="除外をやめる"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBox x:Name="ExcludeBox" Width="260" KeyDown="OnExcludeKey"/>
                                    <Button Style="{StaticResource Btn}" Content="＋ 追加" Padding="18,8" Margin="10,0,0,0"
                                            Foreground="{StaticResource Accent}" Click="OnExcludeAdd"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 下のボタン -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0"
                Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Btn}" Content="初期値に戻す" Click="OnDefaults"
                        ToolTip="画面の値を初期値に戻します（保存するまで反映されません）"/>
                <TextBlock Grid.Column="1" x:Name="FootNote" Text="保存すると画面にすぐ反映されます" FontSize="13"
                           Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Right" Margin="16,0,16,0"/>
                <Button Grid.Column="2" Style="{StaticResource Btn}" Content="キャンセル" Margin="0,0,12,0" Click="OnCancel"/>
                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="保存" Padding="28,10" Click="OnSave"/>
            </Grid>
        </Border>
    </Grid>
</Window>
