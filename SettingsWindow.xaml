                                    <RadioButton Style="{StaticResource Chip}" GroupName="Psu" Tag="gold" Content="Gold"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="Psu" Tag="platinum" Content="Platinum"/>
